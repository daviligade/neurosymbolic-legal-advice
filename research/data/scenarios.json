          "type": "say",
          "text": "Please screen the available products against my confirmed minimum and show the C/D trade-off.",
          "id": "p01-t01"
        },
        {
          "type": "say",
          "text": "For this comparison alone, I choose lower yearly cost. Please display the priority proposal.",
          "id": "p01-t02"
        },
        {
          "type": "control",
          "proposal": {
            "kind": "priority",
            "scope": "$comparison",
            "dimension": "cost"
          },
          "accept": true,
          "recommendation": "D",
          "id": "p01-t03"
        },
        {
          "type": "say",
          "text": "Why is D your recommendation rather than C?",
          "explanation": true,
          "id": "p01-t04"
        },
        {
          "type": "say",
          "text": "Now give the sources and versions for the figures supporting that explanation, including both products.",
          "explanation": true,
          "judge": true,
          "id": "p01-t05"
        }
      ],
      "final_expect": {
        "standing_minimum": 30,
        "episode_minimum": null,
        "recommendation": "D"
      }
    },
